# Base URL da API do backend (contrato OpenAPI sob /api/v1).
# Local: suba o backend com `docker compose up` no repositorio backend-centralizador-financeiro.
#
# Atencao: "localhost" aponta para o proprio aparelho.
#   - Emulador Android: use http://10.0.2.2:3000/api/v1
#   - Dispositivo fisico / Expo Go: use http://<IP-da-sua-maquina-na-LAN>:3000/api/v1
#   - Portas remapeadas (compose.override.yaml): troque 3000 por 3100
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Auth0. Nunca colocar credenciais reais neste arquivo.
#
# Registre uma aplicacao do tipo "Native" no Auth0 (PKCE, sem client secret) e
# adicione em Allowed Callback URLs / Allowed Logout URLs:
#   coinciente://*
#   a URL exp:// que o `pnpm start` imprime, quando rodar no Expo Go
#
# EXPO_PUBLIC_AUTH0_AUDIENCE deve ser identico ao do backend, senao o token e recusado.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
